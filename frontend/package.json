{
  "name": "libra-frontend",
  "version": "0.1.0",
  "description": "Libra - 病棟ベッドサイド向けコミュニケーション補助アプリ",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node --input-type=commonjs -e \"const f=require('fs'),p='dist/sw.js';f.writeFileSync(p,f.readFileSync(p,'utf-8').replace('__BUILD_DATE__',new Date(Date.now()+9*36e5).toISOString().split('T')[0]))\"",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/biz-udpgothic": "^5.3.0",
    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "@solidjs/testing-library": "^0.8.10",
    "jsdom": "^30.1.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-solid": "^2.11.0",
    "vitest": "^5.0.1"
  }
}
